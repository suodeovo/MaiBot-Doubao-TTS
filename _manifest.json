{
  "manifest_version": 2,
  "id": "local.volc.tts2",
  "version": "1.0.1",
  "name": "豆包语音合成 2.0",
  "description": "MaiBot 的豆包语音合成 2.0 插件，提供文字转语音工具、调试命令与公开合成 API，支持音色、情绪标记和缓存。",
  "author": {
    "name": "suodeovo",
    "url": "https://github.com/suodeovo"
  },
  "license": "MIT",
  "plugin_type": "media",
  "urls": {
    "repository": "https://github.com/suodeovo/MaiBot-Doubao-TTS",
    "homepage": "https://github.com/suodeovo/MaiBot-Doubao-TTS",
    "documentation": "https://github.com/suodeovo/MaiBot-Doubao-TTS/blob/main/README.md",
    "issues": "https://github.com/suodeovo/MaiBot-Doubao-TTS/issues"
  },
  "host_application": {
    "min_version": "1.3.16",
    "max_version": "1.3.19"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.21.0"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27.0"
    }
  ],
  "capabilities": [
    "send.custom",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
